# ── Dev Sandbox Configuration ────────────────────────────────────────

# code-server password (shown on the login page)
PASSWORD=changeme

# Port for VS Code web UI
SANDBOX_PORT=8531

# Docker daemon port. Only used if you opt into the loopback binding in
# docker-compose.yml — by default the daemon is internal-only and unpublished.
DIND_PORT=1000

# Host path for DinD's /var/lib/docker (images, layers, build cache).
# MUST be a real local filesystem — an Unraid cache pool under /mnt/<pool>/...
# NEVER a FUSE user share (/mnt/user/...) or a network mount: overlay2 can't
# initialize and containerd's metadata DB hangs there, crash-looping dockerd.
DIND_STORAGE=/mnt/ssd_cache_nvme/appdata/dev-sandbox/dind

# Preview port range — ports exposed from DinD containers to the host.
# When you run  docker run -p 3000:3000 myapp  inside the sandbox,
# port 3000 is accessible at  http://<host-ip>:3000
# Increase PREVIEW_END if you need more ports.
PREVIEW_START=2000
PREVIEW_END=2020

# AI tool API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
